#!/bin/bash

# Bind a Hyprland hotkey that opens Reckon.
#
#   bind-hotkey                    bind SUPER + ALT + C
#   bind-hotkey "SUPER + EQUAL"    bind another chord
#   bind-hotkey --force KEYS       bind it even if the chord is already taken
#   bind-hotkey --remove           take the binding out again
#
# The binding lives in ~/.config/hypr/bindings.lua between two marker lines,
# so running this again replaces it rather than adding a second one.

set -euo pipefail

DEFAULT_KEYS="SUPER + ALT + C"
BINDINGS="$HOME/.config/hypr/bindings.lua"
BEGIN_MARK="-- >>> forcey.reckon hotkey (managed by bind-hotkey)"
END_MARK="-- <<< forcey.reckon hotkey"

fail() {
  echo "bind-hotkey: $*" >&2
  exit 1
}

usage() {
  sed -n '3,11p' "$0" | sed 's/^# \{0,1\}//'
}

hypr_available() {
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null
}

# "super+alt + c" -> "SUPER + ALT + C", the spelling Omarchy's bindings use.
normalize_keys() {
  local IFS="+" part out=()
  read -ra parts <<<"$1"
  for part in "${parts[@]}"; do
    part=$(echo "$part" | xargs)
    [[ -n $part ]] && out+=("${part^^}")
  done
  (( ${#out[@]} > 0 )) || fail "no keys given"
  local joined
  joined=$(printf ' + %s' "${out[@]}")
  echo "${joined:3}"
}

# Hyprland's modmask for the modifiers in a normalized chord.
modmask_for() {
  local mask=0 part
  local IFS="+"
  read -ra parts <<<"$1"
  for part in "${parts[@]:0:${#parts[@]}-1}"; do
    part=$(echo "$part" | xargs)
    case $part in
      SHIFT) (( mask |= 1 )) ;;
      CTRL | CONTROL) (( mask |= 4 )) ;;
      ALT) (( mask |= 8 )) ;;
      SUPER | WIN | LOGO | MOD4) (( mask |= 64 )) ;;
      *) fail "unknown modifier: $part" ;;
    esac
  done
  echo "$mask"
}

key_for() {
  echo "${1##*+}" | xargs
}

# What the chord is bound to now, other than Reckon itself; empty when free.
current_binding() {
  local keys="$1"
  hypr_available || return 0
  hyprctl binds -j 2>/dev/null | jq -r \
    --argjson mask "$(modmask_for "$keys")" \
    --arg key "$(key_for "$keys")" '
      map(select(.modmask == $mask
                 and (.key | ascii_downcase) == ($key | ascii_downcase)
                 and .description != "Reckon"))
      | first | if . then (.description // .arg) else empty end
    '
}

backup() {
  cp "$BINDINGS" "$BINDINGS.bak.$(date +%s)"
}

remove_block() {
  [[ -f $BINDINGS ]] || return 0
  grep -qxF -- "$BEGIN_MARK" "$BINDINGS" || return 0
  local tmp
  tmp=$(mktemp)
  awk -v begin="$BEGIN_MARK" -v end="$END_MARK" '
    $0 == begin { skip = 1; next }
    $0 == end { skip = 0; next }
    !skip
  ' "$BINDINGS" >"$tmp"
  cat "$tmp" >"$BINDINGS"
  rm -f "$tmp"
}

reload_hyprland() {
  if ! hypr_available; then
    echo "Hyprland is not reachable from here; the change applies on its next reload."
    return 0
  fi
  hyprctl reload >/dev/null
  local errors
  errors=$(hyprctl configerrors 2>/dev/null | sed '/^\s*$/d')
  [[ -z $errors ]] || fail "Hyprland reported config errors:"$'\n'"$errors"
}

force=0
remove=0
keys=""

while (( $# > 0 )); do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    --force) force=1; shift ;;
    --remove) remove=1; shift ;;
    -*) fail "unknown option: $1" ;;
    *) [[ -z $keys ]] || fail "unexpected argument: $1"; keys="$1"; shift ;;
  esac
done

[[ -f $BINDINGS ]] || fail "$BINDINGS not found; is this an Omarchy install?"

if (( remove )); then
  grep -qxF -- "$BEGIN_MARK" "$BINDINGS" || { echo "No Reckon hotkey to remove."; exit 0; }
  backup
  remove_block
  reload_hyprland
  echo "Removed the Reckon hotkey."
  exit 0
fi

command -v jq >/dev/null || fail "jq is required"
keys=$(normalize_keys "${keys:-$DEFAULT_KEYS}")
modmask_for "$keys" >/dev/null

taken=$(current_binding "$keys")
if [[ -n $taken ]] && (( ! force )); then
  fail "$keys is already bound to \"$taken\". Pick another chord, or pass --force to unbind it."
fi

backup
remove_block
{
  [[ -z $(tail -n 1 "$BINDINGS") ]] || echo ""
  echo "$BEGIN_MARK"
  [[ -n $taken ]] && echo "hl.unbind(\"$keys\") -- was: $taken"
  echo "o.bind(\"$keys\", \"Reckon\", \"omarchy-shell shell toggle forcey.reckon\")"
  echo "$END_MARK"
} >>"$BINDINGS"

reload_hyprland
echo "Bound $keys to Reckon."
